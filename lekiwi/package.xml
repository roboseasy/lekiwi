<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lekiwi</name>
  <version>0.0.1</version>
  <description>LeKiwi base teleoperation, wheel odometry, and lidar packages.</description>
  <maintainer email="ysj@roboseasy.ai">ysj</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>lekiwi_description</exec_depend>
  <exec_depend>lekiwi_bringup</exec_depend>
  <exec_depend>lekiwi_sensors</exec_depend>
  <exec_depend>lekiwi_node</exec_depend>
  <exec_depend>lekiwi_teleop</exec_depend>
  <exec_depend>lekiwi_cartographer</exec_depend>
  <exec_depend>lekiwi_navigation2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
