<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="lekiwi_lidar_link" params="parent xyz:='0.0 0.0 0.095' rpy:='0.0 0.0 0.0' body_offset_z:='0.018'">
    <link name="lidar_link">
      <visual>
        <origin xyz="0 0 ${body_offset_z}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.035" length="0.036"/>
        </geometry>
        <material name="lekiwi_lidar"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${body_offset_z}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.035" length="0.036"/>
        </geometry>
      </collision>
    </link>

    <joint name="lidar_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="lidar_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="lekiwi_imu_link" params="parent xyz:='0.055 0.0 0.035' rpy:='0.0 0.0 0.0'">
    <link name="imu_link"/>

    <joint name="imu_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="imu_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>
</robot>
